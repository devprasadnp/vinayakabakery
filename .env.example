# Copy to .env (or set as real environment variables) before running with a live gateway.
# Database. DB_HOSTS may list several hosts, tried in order. If startup cannot reach the database, the log
# re-tries every route from that server and prints the DB_HOSTS value that works. DB_URL replaces the whole URL.
# DB_HOSTS=localhost:5432
# DB_NAME=cjgwzcmo_home
# DB_SSLMODE=disable
DB_USERNAME=cjgwzcmo_homeuser
DB_PASSWORD=

# 256-bit (32+ char) secret used to sign JWTs. Change this.
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-characters

# PhonePe Payment Gateway - values are issued in the PhonePe Business dashboard
PHONEPE_MOCK=true
PHONEPE_ENVIRONMENT=SANDBOX
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=1
PHONEPE_REDIRECT_URL=http://localhost:8080/payment/callback
PHONEPE_WEBHOOK_USERNAME=vinayakabakery
PHONEPE_WEBHOOK_PASSWORD=change-me

# Public address of the site. Password-reset links in emails are built from this.
APP_BASE_URL=http://localhost:8080

# Outgoing email for "forgot password" and the admin inbox. Enable it with the "mail" profile
# (automatic under "prod"): mvn spring-boot:run -Dspring-boot.run.profiles=dev,mail
# Without it, dev just writes the reset link to the application log.
# Host/port/username default to the values in application-mail.yml (SMTPS 465 / IMAPS 993,
# implicit TLS); only the password is secret.
SPRING_MAIL_PASSWORD=
# SPRING_MAIL_HOST=mail.srivinayakabakeryhome.com
# SPRING_MAIL_PORT=465
# SPRING_MAIL_USERNAME=admin@srivinayakabakeryhome.com
# SPRING_MAIL_IMAP_HOST=mail.srivinayakabakeryhome.com
# SPRING_MAIL_IMAP_PORT=993
# SPRING_MAIL_IMAP_SSL=true
# MAIL_FROM=Sri Vinayaka Bakery <admin@srivinayakabakeryhome.com>

# Google Maps - shows the store's location on the storefront and lets a customer drop a pin for
# their delivery address at checkout. Leave blank to fall back to a plain lat/lng entry (no map).
# Create a key in Google Cloud Console with the "Maps JavaScript API" enabled and billing on,
# then restrict it to this site's domain(s).
GOOGLE_MAPS_API_KEY=

# Paytm Payment Gateway - Dynamic QR. Leave PAYTM_MOCK=true (default) until these are set; a
# local mock QR page stands in so checkout can be exercised without a merchant account.
# Values are issued on the Paytm Business dashboard (https://dashboard.paytm.com).
PAYTM_MOCK=true
PAYTM_ENVIRONMENT=STAGING
PAYTM_MID=
PAYTM_MERCHANT_KEY=
PAYTM_WEBSITE=WEBSTAGING
PAYTM_INDUSTRY_TYPE=Retail
PAYTM_POS_ID=STORE1
PAYTM_CALLBACK_URL=http://localhost:8080/api/payments/paytm/webhook
